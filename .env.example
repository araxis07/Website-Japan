# Set this to the real deployment origin to enable canonical URLs and the sitemap.
NEXT_PUBLIC_BASE_URL=

# Optional public raster tile provider. All three values are required together.
# Browser keys must be restricted to the deployment origin; never use secret keys.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_CREDIT_NAME=
NEXT_PUBLIC_MAP_CREDIT_URL=
# Optional public HTTPS support form/contact page. GitHub remains the fallback.
NEXT_PUBLIC_CONTACT_URL=
